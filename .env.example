# Names only. Real values stay on your machine and in Vercel / Kaggle, never in this repository.

# Kaggle (runs the worker and holds its private config)
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KERNEL=yourname/panda-worker
KAGGLE_DATASET=yourname/panda-secret

# Claude subscription login: output of `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# What you type in the app. Same value goes to Vercel and into the Kaggle dataset.
PANDA_PASSWORD=

# Tunnel: either a named Cloudflare tunnel (fixed URL)...
CLOUDFLARED_TOKEN=
PANDA_API_URL=
# ...or leave both empty and use a free quick tunnel whose URL is published here:
ENDPOINT_DATASET=yourname/panda-endpoint

# Deploying the web app
VERCEL_TOKEN=
